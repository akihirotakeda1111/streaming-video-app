# Terraform working directory
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*

# Terraform plans
*.tfplan

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local Terraform CLI configuration
.terraformrc
terraform.rc

# Variable files that may contain secrets
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local environment files
.env
.env.*
!.env.example

# Operating system files
.DS_Store
Thumbs.db
