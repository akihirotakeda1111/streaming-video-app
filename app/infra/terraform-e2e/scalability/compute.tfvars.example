allowed_account_ids = ["123456789012"]
project_name       = "streaming-video"
environment        = "scalability-e2e-load"
aws_region         = "ap-northeast-1"
frontend_origin    = "https://frontend.example.invalid"

# Absolute path to the scalability delivery state, matching the delivery
# backend config. This is the unchanged compute root's existing input.
shared_state_path = "/var/lib/streaming-video-e2e/scalability/delivery/terraform.tfstate"
acm_certificate_arn    = "arn:aws:acm:ap-northeast-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"
database_url_secret_arn = "arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:streaming-video/scalability-e2e-database-url"

api_desired_count             = 0
worker_desired_count          = 0
worker_autoscaling_enabled    = false
worker_autoscaling_min_capacity = 1
worker_autoscaling_max_capacity = 4
# Supply immutable api_image_digest and worker_image_digest after publishing.
