# Local PostgreSQL
# DATABASE_URL is for host execution. COMPOSE_DATABASE_URL must use the
# PostgreSQL service name as its host.
DATABASE_URL=postgres://streaming_video:streaming_video_dev_password@localhost:5432/streaming_video?sslmode=disable
COMPOSE_DATABASE_URL=postgres://streaming_video:streaming_video_dev_password@postgres:5432/streaming_video?sslmode=disable
POSTGRES_DB=streaming_video
POSTGRES_USER=streaming_video
POSTGRES_PASSWORD=streaming_video_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Shared AWS/runtime configuration
AWS_REGION=ap-northeast-1
VIDEO_ENCODING_QUEUE_URL=https://sqs.ap-northeast-1.amazonaws.com/123456789012/streaming-video-encoding
VIDEO_INPUT_BUCKET=streaming-video-input-dev
VIDEO_OUTPUT_BUCKET=streaming-video-output-dev
OUTPUT_S3_ENDPOINT=https://streaming-video-output-dev.s3.ap-northeast-1.amazonaws.com
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_VISIBILITY_EXTENSION_SECONDS=120
WORKER_LEASE_DURATION_SECONDS=300
WORKER_RETRY_DELAY_SECONDS=900
WORKER_MAXIMUM_ATTEMPTS=5

# Keep the API and worker credentials separate so each can use its least-
# privilege IAM identity. Never commit real values.
API_AWS_ACCESS_KEY_ID=
API_AWS_SECRET_ACCESS_KEY=
API_AWS_SESSION_TOKEN=
WORKER_AWS_ACCESS_KEY_ID=
WORKER_AWS_SECRET_ACCESS_KEY=
WORKER_AWS_SESSION_TOKEN=

# Browser and API endpoints
FRONTEND_ORIGIN=http://localhost:5173
HTTP_ADDR=0.0.0.0:8080
API_PORT=8080
FRONTEND_PORT=5173
API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Worker runtime
FFMPEG_PATH=/usr/bin/ffmpeg
TMPDIR=/tmp/streaming-video-app
