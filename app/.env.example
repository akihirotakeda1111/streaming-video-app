# Local PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=streaming_video
POSTGRES_USER=streaming_video
POSTGRES_PASSWORD=streaming_video
DATABASE_URL=postgres://streaming_video:streaming_video@localhost:5432/streaming_video?sslmode=disable

# Shared application configuration
AWS_REGION=us-east-1
ENCODING_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/streaming-video-encoding
VIDEO_INPUT_BUCKET=streaming-video-input
VIDEO_OUTPUT_BUCKET=streaming-video-output
FRONTEND_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:8080
FFMPEG_PATH=/usr/bin/ffmpeg
TMPDIR=/tmp/streaming-video-app
