# Local PostgreSQL
# Keep DATABASE_URL in sync with POSTGRES_* below. Compose interpolates the
# parts independently, so a one-sided override will break client connections.
DATABASE_URL=postgres://streaming_video:streaming_video_dev_password@localhost:5432/streaming_video?sslmode=disable
POSTGRES_DB=streaming_video
POSTGRES_USER=streaming_video
POSTGRES_PASSWORD=streaming_video_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Shared AWS/runtime configuration
AWS_REGION=us-east-1
VIDEO_ENCODING_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/streaming-video-encoding
VIDEO_INPUT_BUCKET=streaming-video-input-dev
VIDEO_OUTPUT_BUCKET=streaming-video-output-dev

# Browser and API endpoints
FRONTEND_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:8080

# Worker runtime
FFMPEG_PATH=/usr/bin/ffmpeg
TMPDIR=/tmp/streaming-video-app
